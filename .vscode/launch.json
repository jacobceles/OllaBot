{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Streamlit App",
        "type": "debugpy",
        "request": "launch",
        "module": "streamlit",
        "args": [
            "run",
            "app.py",
            "--", 
            "--local"
        ],
        "jinja": true,
        "justMyCode": false,
        "preLaunchTask": "start-ollama-models"
    },
    {
      "name": "FastAPI Server",
      "type": "debugpy",
      "request": "launch",
      "module": "server",
      "args": [
          "--local"
      ],
      "jinja": true,
      "justMyCode": false
    } 
  ],
  "compounds": [
      {
          "name": "Streamlit + FastAPI",
          "configurations": ["Streamlit App", "FastAPI Server"]
      }
  ]
}
